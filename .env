DB_MIN_POOL=2
DB_MAX_POOL=10
# Nếu dùng Supabase Connection Pooler: DB_HOST=aws-0-<region>.pooler.supabase.com,
# DB_USER=postgres.<project-ref> (bắt buộc có phần .<project-ref>), DB_PORT=5432 (Session mode)
DB_SSLMODE=require

PERSISTENCE_FILE=storage/bot_persistence.pickle
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Thư mục chứa file .kml của từng tuyến cáp (tên file = route_code hoặc route_name)
ROUTE_KML_DIR=data/kml

# Cổng chạy dashboard Streamlit khi khởi động qua systemd service fiber_rescue
DASHBOARD_PORT=8501

#PHOTO_STORAGE_DIR=storage/photos
CLOUDINARY_CLOUD_NAME=p0x7kszi
CLOUDINARY_API_KEY=546165376548241
CLOUDINARY_API_SECRET=CTKkVaarf1KqRpr4hlsOPXv5bII
CLOUDINARY_FOLDER=fiber_rescue/tests
# Chỉ cần điền nếu máy chủ ra internet qua proxy (Cloudinary SDK không tự đọc
# HTTP_PROXY/HTTPS_PROXY như Telegram) - để trống thì tự lấy theo HTTPS_PROXY/HTTP_PROXY hệ thống
CLOUDINARY_PROXY=

# Telegram user_id của admin (cách nhau bởi dấu phẩy), nhận thông báo user mới & dùng /setrole
ADMIN_TELEGRAM_IDS=2044648771

# ---- OCR toạ độ từ ảnh sự cố (provider cloud, có fallback tự động) ----
# Thứ tự thử provider, cách nhau bởi dấu phẩy — đổi thứ tự hoặc thêm/bớt
# provider tại đây, không cần sửa code (xem ocr/service.py).
OCR_PROVIDER_ORDER=ocr_space,google_vision
# OCR.space: https://ocr.space/ocrapi (có gói free)
OCR_SPACE_API_KEY=K81536963388957
# Google Cloud Vision: https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEY=AIzaSyDR1fnBsbUbdGpI3GMwwTiSusc0OgtVl5w
OCR_REQUEST_TIMEOUT_SECONDS=20
OCR_MIN_CONFIDENCE=0.8
OCR_WORKER_POLL_INTERVAL_SECONDS=5
OCR_WORKER_BATCH_SIZE=5
# Sai khác giữa toạ độ OCR và GPS Telegram (mét) vượt ngưỡng này -> coordinate_status=CONFLICT
COORDINATE_CONFLICT_THRESHOLD_M=2000000
COORDINATE_VALIDATE_VN_BOUNDS=true
VN_LAT_MIN=8.0
VN_LAT_MAX=23.5
VN_LON_MIN=102.0
VN_LON_MAX=110.0
